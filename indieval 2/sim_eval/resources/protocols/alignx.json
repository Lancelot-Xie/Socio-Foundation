{
  "schema_version": "1.0",
  "benchmark_id": "alignx",
  "execution": {
    "profile": "alignx_live",
    "repetitions": 1,
    "max_workers": 32,
    "request_timeout_seconds": 120,
    "episode_max_output_tokens": 32768
  },
  "roles": {
    "evaluated_model": {
      "backend": "vllm",
      "extra_body": {
        "chat_template_kwargs": {
          "enable_thinking": false
        }
      },
      "base_url": "http://127.0.0.1:8000/v1",
      "api_key_env": "ALIGNX_API_KEY",
      "require_api_key": false,
      "model": "replace-with-evaluated-model-model",
      "model_revision": "replace-with-immutable-revision",
      "generation": {
        "temperature": 0.0,
        "max_tokens": 1024
      }
    }
  },
  "routing": {
    "default_role": "evaluated_model"
  },
  "prompts": {
    "binary_choice": {
      "source": "supplemental_compat",
      "revision": "alignx-supplemental-answer-tag-v2-frozen-arbitrary-mixture",
      "locator": "sim_eval/benchmarks/alignx.py"
    },
    "arbitrary_conditioning": {
      "source": "official_repository",
      "revision": "alignx-arbitrary-frozen-mixed-signals-v2",
      "locator": "https://github.com/JinaLeejnl/AlignX/blob/main/eval/loss_ica.py"
    }
  },
  "resources": {
    "reference_model": {
      "enabled": false,
      "reason": "user_selected_direct_binary_choice_only"
    }
  }
}
