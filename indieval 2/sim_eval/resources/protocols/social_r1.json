{
  "schema_version": "1.0",
  "benchmark_id": "social_r1",
  "execution": {
    "profile": "social_r1_100_live",
    "repetitions": 1,
    "max_workers": 32,
    "request_timeout_seconds": 120,
    "episode_max_output_tokens": 32768
  },
  "roles": {
    "evaluated_model": {
      "backend": "vllm",
      "extra_body": {
        "chat_template_kwargs": {
          "enable_thinking": false
        }
      },
      "base_url": "http://127.0.0.1:8000/v1",
      "api_key_env": "SOCIAL_R1_API_KEY",
      "require_api_key": false,
      "model": "replace-with-evaluated-model-model",
      "model_revision": "replace-with-immutable-revision",
      "generation": {
        "temperature": 0.0,
        "max_tokens": 2048
      }
    }
  },
  "routing": {
    "default_role": "evaluated_model"
  },
  "prompts": {
    "multiple_choice": {
      "source": "official_paper",
      "revision": "social-r1-tombench-hard-mcq-v1",
      "locator": "sim_eval/benchmarks/social_r1.py"
    }
  },
  "resources": {
    "dataset_status": "supplemental_author-project_compat_until_official_test_release"
  }
}
