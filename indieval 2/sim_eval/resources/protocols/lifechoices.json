{
  "schema_version": "1.0",
  "benchmark_id": "lifechoices",
  "execution": {
    "profile": "lifechoices_live",
    "repetitions": 1,
    "max_workers": 32,
    "request_timeout_seconds": 120,
    "episode_max_output_tokens": 32768
  },
  "roles": {
    "evaluated_model": {
      "backend": "vllm",
      "extra_body": {
        "chat_template_kwargs": {
          "enable_thinking": false
        }
      },
      "base_url": "http://127.0.0.1:8000/v1",
      "api_key_env": "LIFECHOICES_API_KEY",
      "require_api_key": false,
      "model": "replace-with-evaluated-model-model",
      "model_revision": "replace-with-immutable-revision",
      "generation": {
        "temperature": 0.0,
        "max_tokens": 1024
      }
    }
  },
  "routing": {
    "default_role": "evaluated_model"
  },
  "prompts": {
    "character_choice": {
      "source": "supplemental_compat",
      "revision": "lifechoice-supplemental-answer-tag-v1-natural-material-v1",
      "locator": "sim_eval/benchmarks/lifechoices.py"
    }
  },
  "resources": {
    "context_condition": "expert_written_description_public_condition"
  }
}
