{
  "schema_version": "1.0",
  "benchmark_id": "behaviorchain",
  "execution": {
    "profile": "behaviorchain_live",
    "repetitions": 1,
    "max_workers": 32,
    "request_timeout_seconds": 120,
    "episode_max_output_tokens": 32768
  },
  "roles": {
    "evaluated_model": {
      "backend": "vllm",
      "extra_body": {
        "chat_template_kwargs": {
          "enable_thinking": false
        }
      },
      "base_url": "http://127.0.0.1:8000/v1",
      "api_key_env": "BEHAVIORCHAIN_API_KEY",
      "require_api_key": false,
      "model": "replace-with-evaluated-model-model",
      "model_revision": "replace-with-immutable-revision",
      "generation": {
        "temperature": 0.0,
        "max_tokens": 1024
      }
    },
    "generation_judge": {
      "backend": "chat_completions",
      "profile": "relay",
      "model": "replace-with-generation-judge-model",
      "model_revision": "replace-with-immutable-revision",
      "generation": {
        "temperature": 0.0,
        "max_tokens": 4096
      },
      "fallback": {
        "trigger": "safety_filter",
        "profile": "deepseek",
        "model": "replace-with-fallback-model",
        "model_revision": "replace-with-immutable-revision",
        "generation": {
          "temperature": 0.0,
          "max_tokens": 4096
        },
        "fallback_reason": "primary_judge_explicitly_blocked_by_safety_filter"
      }
    }
  },
  "routing": {
    "default_role": "evaluated_model"
  },
  "prompts": {
    "prediction": {
      "source": "supplemental_compat",
      "revision": "behaviorchain-supplemental-answer-tag-v2-chain-pseudonyms",
      "locator": "sim_eval/benchmarks/behaviorchain.py"
    },
    "name_anonymization": {
      "source": "indieval_reconstruction",
      "revision": "behaviorchain-chain-stable-boundary-pseudonyms-v1",
      "locator": "sim_eval/benchmarks/behaviorchain.py"
    },
    "generation_judge": {
      "source": "indieval_reconstruction",
      "revision": "behaviorchain-generation-evaluator-v3-pseudonym-context",
      "locator": "sim_eval/benchmarks/behaviorchain.py"
    }
  },
  "resources": {
    "initial_nodes_policy": "context_only_not_scored"
  }
}
