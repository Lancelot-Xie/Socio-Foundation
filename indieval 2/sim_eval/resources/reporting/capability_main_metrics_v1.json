      "metric_type": "character_fidelity",
      "representative": true
    },
    {
      "dimension": "F",
      "dataset": "HUMANUAL",
      "entry": "humanual",
      "metric": "humanual.response_alignment",
      "label": "HUMANUAL · Response alignment",
      "note": "",
