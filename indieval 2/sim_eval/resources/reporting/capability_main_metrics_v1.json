{
  "schema_version": "1.0",
  "mapping_revision": "capability-main-metrics-five-dimensions-v3",
  "aggregation": "group_only_no_composite_score",
  "dimensions": [
    {
      "id": "F",
      "name_en": "Individual Fidelity",
      "name_zh": "个体保真",
      "question": "是否复现目标个体、角色、偏好、状态及给定意图"
    },
    {
      "id": "S",
      "name_en": "Social-State Grounding",
      "name_zh": "社会状态理解",
      "question": "是否理解他人的信念、知识、意图、情绪和私有信息"
    },
    {
      "id": "U",
      "name_en": "User Utility & Outcome Realization",
      "name_zh": "用户效用与结果实现",
      "question": "是否推进目标并产生实际任务或社会结果"
    },
    {
      "id": "T",
      "name_en": "Sequential & Narrative Coherence",
      "name_zh": "序列与叙事连贯性",
      "question": "多轮行为是否前后连贯、符合因果和情节发展"
    },
    {
      "id": "N",
      "name_en": "Human Behavioral Realism",
      "name_zh": "人类行为真实性",
      "question": "表达、反应、披露、终止及结果分布是否接近真实人类"
    }
  ],
  "selection_notes": [
    "主表按 F/S/U/T/N 五维展开，同一数据集在一个维度下可保留多类重要指标；不计算维度均分或跨指标总分。",
    "FANToM 主表固定为 item accuracy；ALL/ALL*、二分类 F1 等保留在详细表，不按可用性替换。",
    "BehaviorChain F 固定为 node_micro_score，T 为 CumScore；AvgScore 保留在详细表。",
    "HUMANUAL 保留 response/state；CoSER T 保留 storyline consistency/quality。",
    "MirrorBench 保留 GTEval 与 MATTR z-score；后者越接近 0 越好。",
    "τ-USI 在 N 保留 Eval、outcome alignment、USI；USI 与组件不再相加。",
    "UserLM intent adherence 属于 F；role adherence 和 termination F1 属于 N。",
    "one-per-dataset 是可选阅读缩略版，不是默认主表。",
    "SOTOPIA Believability 按人物表现可信度归入 F，原始评分与数值不变。"
  ],
  "metrics": [
    {
      "dimension": "F",
      "dataset": "LifeChoices",
      "entry": "lifechoices",
      "metric": "lifechoices.accuracy",
      "label": "LifeChoices · 选择准确率",
      "note": "",
      "metric_type": "choice",
      "representative": true
    },
    {
      "dimension": "F",
      "dataset": "AlignX",
      "entry": "alignx",
      "metric": "alignx.direct_choice_accuracy",
      "label": "AlignX · 直接选择准确率",
      "note": "使用当前 direct-choice 协议，不替换成 reference-margin 指标。",
      "metric_type": "choice",
      "representative": true
    },
    {
      "dimension": "F",
      "dataset": "HumanLLM",
      "entry": "humanllm",
      "metric": "humanllm.diagnostic.top5_accuracy",
      "label": "HumanLLM · Top-5 准确率",
      "note": "",
      "metric_type": "ranking",
      "representative": true
    },
    {
      "dimension": "F",
      "dataset": "BehaviorChain",
      "entry": "behaviorchain",
      "metric": "behaviorchain.diagnostic.node_micro_score",
      "label": "BehaviorChain · Node score",
      "note": "节点级微平均准确率；AvgScore（按链等权）另列于数据集明细，不互相替代。",
      "metric_type": "node_accuracy",
      "representative": true
    },
    {
      "dimension": "F",
